# =============================================================================
# Coddingtown Jewelers — Environment Variables Template
# Copy to `.env.local` (or add in Vercel Project Settings -> Environment Variables)
# =============================================================================

# --- Required for Live Catalogue (Vercel + Local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Required for Sync Scripts Only (Local / GitHub Actions — NOT needed on public client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Stuller API v2 (scripts/sync-stuller.ts) ---
STULLER_API_USERNAME=
STULLER_API_PASSWORD=
STULLER_API_BASE_URL=https://api.stuller.com/v2/products

# --- Quality Gold Local Feed (scripts/sync-quality-gold.ts) ---
QUALITY_GOLD_FEED_PATH=

# --- Next.js Server Caching & On-Demand Cache Refresh (Vercel) ---
CATALOG_CACHE_TTL_SECONDS=86400
REVALIDATE_SECRET=
REVALIDATE_URL=https://your-domain.com/api/revalidate

# --- Store Identity & Contact (Optional Overrides for src/config/site.ts) ---
NEXT_PUBLIC_STORE_NAME="Coddingtown Jewelers"
NEXT_PUBLIC_STORE_LOGO="/images/logo-artisanal-script.png"
NEXT_PUBLIC_STORE_PHONE="+1 707 546 4884"
NEXT_PUBLIC_STORE_EMAIL="hello@coddingtownjewelers.com"
NEXT_PUBLIC_STORE_ADDRESS="348 Coddingtown Ctr, Santa Rosa, CA 95401"

# --- Optional Yelp Link & API ---
NEXT_PUBLIC_YELP_URL="https://www.yelp.com/biz/coddingtown-jewelers-santa-rosa"
YELP_API_KEY=
YELP_BUSINESS_ID=coddingtown-jewelers-santa-rosa
